#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00;
    float amount;

    do {
        printf("BSIT BANK\n");
        printf("Please select your Transaction:\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice:");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
            printf("\nYour current balance is: P%.2f\n\n", balance);
            break;
            
            case 2:
            printf("\nEnter the amount to deposit: P");
            scanf("%f", &amount);
            if (amount > 0) {
            balance += amount;
            printf("P%.2f deposited successfully!\n\n", amount);
        }else{
            printf("Invalid amount");
        }
        break;

        case 3:
        printf("Enter amount to withdraw: ");
        scanf("%f", &amount);
        
        if ((balance - amount) < 100.00) {
            printf("Withdrawal denied! You must maintain at least P100.00 in your account.\n\n");
        } else if (amount <= 0) {
            printf("Invalid amount!\n\n");
        } else {
            balance -= amount;
            printf("You withdraw P%.2f successfully!\n\n", amount);
        }
        break;
        case 4:
        printf("Thank you for using BSIT BANK!\n");
        break;

        default:
        printf("Invalid choice! Please select an option from 1 to 4.\n\n");
        }
        
    } while (choice != 4);
    return 0;
}
